{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "out/**"
      ],
      "env": [
        "NEXT_PUBLIC_CONTACT_ENDPOINT",
        "NEXT_PUBLIC_CONTACT_FORM_MODE",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_BLOG_URL",
        "NEXT_PUBLIC_SQUARECAMPUS_URL",
        "NEXT_PUBLIC_FAIRHELM_URL",
        "CONTENT_BUILD_DATE",
        "NEXT_PUBLIC_LEGAL_URL",
        "NEXT_PUBLIC_PRESS_URL"
      ],
      "passThroughEnv": [
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "NO_PROXY"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NEXT_PUBLIC_CONTACT_ENDPOINT",
        "NEXT_PUBLIC_CONTACT_FORM_MODE",
        "NEXT_PUBLIC_BLOG_URL",
        "NEXT_PUBLIC_SQUARECAMPUS_URL",
        "NEXT_PUBLIC_FAIRHELM_URL",
        "NEXT_PUBLIC_LEGAL_URL",
        "NEXT_PUBLIC_PRESS_URL"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^test"
      ],
      "cache": false
    }
  }
}
